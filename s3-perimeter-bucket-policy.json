{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnforceCorporateNetworkBoundary",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::grc-secure-financial-vault-2026",
        "arn:aws:s3:::grc-secure-financial-vault-2026/*"
      ],
      "Condition": {
        "NotIpAddress": {
          "aws:SourceIp": [
            "192.0.2.0/24"
          ]
        }
      }
    }
  ]
}
